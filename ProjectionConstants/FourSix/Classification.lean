/-- **The classification, checked by the kernel.** -/
theorem checkTable_classificationTable : checkTable 0 classificationTable = true := by
  decide +kernel

/-- The table has one entry for each of the `1024` codes. -/
lemma classificationTable_length : classificationTable.length = 1024 := by decide +kernel

/-- `twoGraphRepMask` encodes the representatives `twoGraphRep` (checked by the kernel). -/
lemma twoGraphRep_eq_mask :
    ∀ t : Fin 16, ∀ p : Fin 6 × Fin 6, twoGraphRep t p.1 p.2 =
      if (twoGraphRepMask.getD t 0).testBit (6 * p.1 + p.2) then -1 else 1 := by
  decide +kernel

/-- If `checkTable b₀ l` holds, then the `k`-th entry of `l` is correct for the code `b₀ + k`. -/
lemma checkTable_sound : ∀ (b₀ : ℕ) (l : List (ℕ × ℕ × ℕ)), checkTable b₀ l = true →
    ∀ k < l.length, checkEntry (b₀ + k) (l.getD k (0, 0, 0)) = true
  | _, [], _, k, hk => absurd hk (by simp)
  | b₀, e :: es, h, k, hk => by
    simp only [checkTable, Bool.and_eq_true] at h
    cases k with
    | zero => simpa using h.1
    | succ k =>
      have := checkTable_sound (b₀ + 1) es h.2 k (by simpa using hk)
      simpa [Nat.add_assoc, Nat.add_comm 1 k] using this

/-- A correct entry gives a representative `twoGraphRep t`, a permutation `σ` and a sign vector
`ε` with `twoGraphRep t = E (N_b)_σ E`. -/
theorem checkEntry_sound {b : ℕ} {e : ℕ × ℕ × ℕ} (h : checkEntry b e = true) :
    ∃ (t : Fin 16) (σ : Fin 6 ≃ Fin 6) (ε : Fin 6 → Bool), ∀ i j : Fin 6,
      ((twoGraphRep t i j : ℤ) : ℝ) =
        boolSign (ε i) * boolSign (ε j) * boolSign (normalizedPattern b (σ i) (σ j)) := by
  simp only [checkEntry, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true,
    List.mem_range] at h
  obtain ⟨ht, hall⟩ := h
  have hdig : ∀ i : Fin 6, octalDigit e.2.1 i < 6 := fun i ↦ (hall i i.2).1
  have hok : ∀ i j : Fin 6, entryOk b e.1 e.2.1 (twoGraphRepMask.getD e.2.2 0) i j = true :=
    fun i j ↦ (hall i i.2).2 j j.2
  set f : Fin 6 → Fin 6 := fun i ↦ ⟨octalDigit e.2.1 i, hdig i⟩ with hf
  have hinj : Function.Injective f := fun i j hij ↦ by
    have h1 := ((Bool.and_eq_true _ _).mp (hok i j)).1
    have h2 : octalDigit e.2.1 i = octalDigit e.2.1 j := congrArg Fin.val hij
    simp only [beq_iff_eq] at h1
    rw [Bool.eq_iff_iff] at h1
    simp only [beq_iff_eq] at h1
    exact Fin.ext (h1.mp h2)
  refine ⟨⟨e.2.2, ht⟩, Equiv.ofBijective f (Finite.injective_iff_bijective.mp hinj),
    fun i ↦ e.1.testBit i, fun i j ↦ ?_⟩
  have h1 := ((Bool.and_eq_true _ _).mp (hok i j)).2
  rw [beq_iff_eq, ← Bool.xor_assoc] at h1
  rw [twoGraphRep_eq_mask ⟨e.2.2, ht⟩ (i, j)]
  simp only [Equiv.ofBijective_apply, hf, ← boolSign_xor]
  rw [← h1]
  cases (twoGraphRepMask.getD e.2.2 0).testBit (6 * i + j) <;> simp [boolSign]

/-- Every code `b < 2¹⁰` is covered by the table. -/
theorem exists_twoGraphRep_of_lt {b : ℕ} (hb : b < 1024) :
    ∃ (t : Fin 16) (σ : Fin 6 ≃ Fin 6) (ε : Fin 6 → Bool), ∀ i j : Fin 6,
      ((twoGraphRep t i j : ℤ) : ℝ) =
        boolSign (ε i) * boolSign (ε j) * boolSign (normalizedPattern b (σ i) (σ j)) := by
  have h := checkTable_sound 0 classificationTable checkTable_classificationTable b
    (by rw [classificationTable_length]; exact hb)
  rw [zero_add] at h
  exact checkEntry_sound h

/-! ### The bound for all sign matrices -/

/-- **Every sign matrix of order six.** `Tr(√D S √D P) ≤ 5/3` for every `S ∈ 𝒮₆`, `D ∈ 𝒟₆` and
every orthogonal projection `P`. -/
theorem frobeniusInner_weightedSign_le_five_thirds {S : Matrix (Fin 6) (Fin 6) ℝ}
    (hS : IsSignMatrix S) {w : Fin 6 → ℝ} (hw : IsWeight w) {P : Matrix (Fin 6) (Fin 6) ℝ}
    (hP : IsStarProjection P) : frobeniusInner (weightedSign S w) P ≤ 5 / 3 := by
  -- switch `S` so that its first row is `(1, …, 1)`
  set ε₀ : Fin 6 → ℝ := fun j ↦ S 0 j with hε₀def
  have hε₀ : ∀ j, ε₀ j * ε₀ j = 1 := fun j ↦ hS.mul_self_eq 0 j
  set S₁ := signSwitch ε₀ S with hS₁def
  have hS₁ : IsSignMatrix S₁ := isSignMatrix_signSwitch hε₀ hS
  have h0 : ∀ j, S₁ 0 j = 1 := fun j ↦ by
    simp only [hS₁def, signSwitch, of_apply, hε₀def, hS.diag, one_mul]
    exact hS.mul_self_eq 0 j
  rw [← frobeniusInner_signSwitch hε₀ (weightedSign S w) P, ← weightedSign_signSwitch]
  -- its code, and the entry of the table
  obtain ⟨-, hSb⟩ := codeOf_spec hS₁ h0
  obtain ⟨t, σ, ε, hT⟩ := exists_twoGraphRep_of_lt (codeOf_spec hS₁ h0).1
  set ε' : Fin 6 → ℝ := fun i ↦ boolSign (ε i) with hε'def
  have hε' : ∀ i, ε' i * ε' i = 1 := fun i ↦ boolSign_mul_self _
  have hTS : (twoGraphRep t).map (Int.cast : ℤ → ℝ) = signSwitch ε' (S₁.submatrix σ σ) := by
    ext i j
    simp only [map_apply, hT, signSwitch, of_apply, submatrix_apply, hε'def, hSb]
    ring
  calc frobeniusInner (weightedSign S₁ w) (signSwitch ε₀ P)
      = frobeniusInner (weightedSign (S₁.submatrix σ σ) (w ∘ σ))
          ((signSwitch ε₀ P).submatrix σ σ) := by
        rw [weightedSign_submatrix, frobeniusInner_submatrix]
    _ = frobeniusInner (weightedSign ((twoGraphRep t).map (Int.cast : ℤ → ℝ)) (w ∘ σ))
          (signSwitch ε' ((signSwitch ε₀ P).submatrix σ σ)) := by
        rw [hTS, weightedSign_signSwitch, frobeniusInner_signSwitch hε']
    _ ≤ 5 / 3 := frobeniusInner_weightedSign_twoGraphRep_le t (hw.comp_equiv σ)
        (isStarProjection_signSwitch hε' ((isStarProjection_signSwitch hε₀ hP).submatrix σ))

end ProjectionConstants.FourSix
