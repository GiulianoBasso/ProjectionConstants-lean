/-- The certificates are valid (checked by the kernel). -/
lemma otherCertificates_isValid : ∀ k, (otherCertificates k).IsValid (otherTwoGraphs k) := by
  decide +kernel

/-- The diagonal entries of the representatives are `1`. -/
lemma otherTwoGraphs_apply_self : ∀ k, ∀ i, otherTwoGraphs k i i = 1 := by decide +kernel

/-- The representatives of the sixteen two-graphs on six vertices: `A1, A2, A3` and
`otherTwoGraphs`. -/
def twoGraphRep : Fin 16 → Matrix (Fin 6) (Fin 6) ℤ :=
  ![A1Int, A2Int, A3Int, otherTwoGraphs 0, otherTwoGraphs 1, otherTwoGraphs 2, otherTwoGraphs 3,
    otherTwoGraphs 4, otherTwoGraphs 5, otherTwoGraphs 6, otherTwoGraphs 7, otherTwoGraphs 8,
    otherTwoGraphs 9, otherTwoGraphs 10, otherTwoGraphs 11, otherTwoGraphs 12]

/-- `Tr(√D T √D P) ≤ 5/3` for each representative `T`: by `M₁`, `M₂`, `M₃` for `A1, A2, A3`, and
by the rational certificates for the others. -/
theorem frobeniusInner_weightedSign_twoGraphRep_le (t : Fin 16) {w : Fin 6 → ℝ} (hw : IsWeight w)
    {P : Matrix (Fin 6) (Fin 6) ℝ} (hP : IsStarProjection P) :
    frobeniusInner (weightedSign ((twoGraphRep t).map (Int.cast : ℤ → ℝ)) w) P ≤ 5 / 3 := by
  have h : ∀ k : Fin 13,
      frobeniusInner (weightedSign ((otherTwoGraphs k).map (Int.cast : ℤ → ℝ)) w) P ≤ 5 / 3 :=
    fun k ↦ SosCertificate.frobeniusInner_weightedSign_le (otherTwoGraphs_apply_self k)
      (otherCertificates_isValid k) hw hP
  fin_cases t
  · exact frobeniusInner_weightedSign_A1_le hw hP
  · exact frobeniusInner_weightedSign_A2_le hw hP
  · exact frobeniusInner_weightedSign_A3_le hw hP
  · exact h 0
  · exact h 1
  · exact h 2
  · exact h 3
  · exact h 4
  · exact h 5
  · exact h 6
  · exact h 7
  · exact h 8
  · exact h 9
  · exact h 10
  · exact h 11
  · exact h 12

/-! ### Codes of normalized sign matrices -/

/-- The sign `±1` of a Boolean: `true ↦ -1`, `false ↦ 1`. -/
def boolSign (x : Bool) : ℝ := if x then -1 else 1

/-- `boolSign` turns `xor` into multiplication. -/
lemma boolSign_xor (x y : Bool) : boolSign (x ^^ y) = boolSign x * boolSign y := by
  cases x <;> cases y <;> norm_num [boolSign]

/-- `boolSign x = ±1` squares to `1`. -/
lemma boolSign_mul_self (x : Bool) : boolSign x * boolSign x = 1 := by
  cases x <;> norm_num [boolSign]

@[simp] lemma boolSign_false : boolSign false = 1 := rfl

/-- The index of the pair `{a, c}` among the ten pairs `{1, 2}, {1, 3}, …, {4, 5}` of
`{1, …, 5}`, in lexicographic order. -/
def pairIndex (a c : ℕ) : ℕ := (min a c - 1) * (10 - min a c) / 2 + (max a c - min a c - 1)

/-- The normalized sign pattern `N_b` with code `b` (`true` stands for the entry `-1`): the first
row and column and the diagonal are `+1`, and for `1 ≤ a ≠ c ≤ 5` the entry `(a, c)` is `-1` iff
the bit `pairIndex a c` of `b` is set. -/
def normalizedPattern (b a c : ℕ) : Bool :=
  !(a == 0 || c == 0 || a == c) && b.testBit (pairIndex a c)

/-- The number with the binary digits `l` (least significant first). -/
def ofBits : List Bool → ℕ
  | [] => 0
  | x :: l => Nat.bit x (ofBits l)

/-- The bit `k` of `ofBits l` is the `k`-th entry of `l`. -/
lemma testBit_ofBits (l : List Bool) (k : ℕ) : (ofBits l).testBit k = l.getD k false := by
  induction l generalizing k with
  | nil => simp [ofBits]
  | cons x l ih =>
    cases k with
    | zero => simp [ofBits]
    | succ k => simp [ofBits, Nat.testBit_bit_succ, ih]

/-- `ofBits l` has at most `l.length` binary digits. -/
lemma ofBits_lt (l : List Bool) : ofBits l < 2 ^ l.length := by
  induction l with
  | nil => simp [ofBits]
  | cons x l ih =>
    simp only [ofBits, Nat.bit_val, List.length_cons, pow_succ]
    cases x <;> simp <;> omega

/-- The code of a sign matrix whose first row is `(1, …, 1)`. -/
noncomputable def codeOf (S : Matrix (Fin 6) (Fin 6) ℝ) : ℕ :=
  ofBits ([(1, 2), (1, 3), (1, 4), (1, 5), (2, 3), (2, 4), (2, 5), (3, 4), (3, 5), (4, 5)].map
    fun p : Fin 6 × Fin 6 ↦ decide (S p.1 p.2 = -1))

/-- A sign matrix with first row `(1, …, 1)` is the sign pattern of its code. -/
theorem codeOf_spec {S : Matrix (Fin 6) (Fin 6) ℝ} (hS : IsSignMatrix S) (h0 : ∀ j, S 0 j = 1) :
    codeOf S < 1024 ∧ ∀ i j : Fin 6, S i j = boolSign (normalizedPattern (codeOf S) i j) := by
  refine ⟨?_, ?_⟩
  · unfold codeOf
    simpa using ofBits_lt ([(1, 2), (1, 3), (1, 4), (1, 5), (2, 3), (2, 4), (2, 5), (3, 4), (3, 5),
      (4, 5)].map fun p : Fin 6 × Fin 6 ↦ decide (S p.1 p.2 = -1))
  have key : ∀ a c, boolSign (decide (S a c = -1)) = S a c := fun a c ↦ by
    rcases hS.pm a c with h | h <;> norm_num [boolSign, h]
  have h0' : ∀ i, S i 0 = 1 := fun i ↦ (hS.symm 0 i).trans (h0 i)
  intro i j
  simp only [codeOf, normalizedPattern, testBit_ofBits]
  fin_cases i <;> fin_cases j <;> simp [pairIndex, key, boolSign_false, h0, h0', hS.diag, hS.symm]

/-! ### The table -/

/-- The bit masks of the representatives: the bit `6i + j` of the `t`-th entry is set iff
`(twoGraphRep t)ᵢⱼ = -1` (see `twoGraphRep_eq_mask`). -/
def twoGraphRepMask : List ℕ :=
  [22150250562, 26453483776, 1108378656, 0, 8448, 533248, 1614592, 34636800,
    34645248, 35170048, 102336000, 102344448, 2216266240, 240756480, 6615632896, 32998403840]

/-- The `i`-th octal digit of `s`: the image of `i` under the permutation encoded by `s`. -/
def octalDigit (s i : ℕ) : ℕ := (s >>> (3 * i)) % 8

/-- The condition at the position `(i, j)` on the entry `(ε, σ, t)` of the table for the code `b`,
where `m` is the `t`-th entry of `twoGraphRepMask`: `σᵢ = σⱼ` iff `i = j`, and
`(twoGraphRep t)ᵢⱼ = εᵢ εⱼ (N_b)_{σᵢ σⱼ}` (bitwise: `xor`). -/
def entryOk (b ε σ m i j : ℕ) : Bool :=
  ((octalDigit σ i == octalDigit σ j) == (i == j)) &&
    (m.testBit (6 * i + j) ==
      (ε.testBit i ^^ (ε.testBit j ^^ normalizedPattern b (octalDigit σ i) (octalDigit σ j))))

/-- The entry `e = (ε, σ, t)` of the table is correct for the code `b`. -/
def checkEntry (b : ℕ) (e : ℕ × ℕ × ℕ) : Bool :=
  decide (e.2.2 < 16) && (List.range 6).all fun i ↦ decide (octalDigit e.2.1 i < 6) &&
    (List.range 6).all fun j ↦ entryOk b e.1 e.2.1 (twoGraphRepMask.getD e.2.2 0) i j

/-- All entries of a list are correct, starting with the code `b`. -/
def checkTable : ℕ → List (ℕ × ℕ × ℕ) → Bool
  | _, [] => true
  | b, e :: es => checkEntry b e && checkTable (b + 1) es

